{
  "name": "aio-ide",
  "displayName": "AIO · AI CLI 工作台",
  "description": "在项目终端中打开本机 OMP、Claude Code 和 Codex，或进入 AIO 工作台。",
  "version": "0.1.16",
  "icon": "media/aio.png",
  "publisher": "ancoder",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/AncoderAI/AIO_IDE_Plugin.git" },
  "engines": { "vscode": "^1.97.0" },
  "categories": ["Other"],
  "extensionKind": ["workspace"],
  "main": "./src/extension.js",
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": { "supported": false }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:workbench": "node scripts/build-workbench.cjs",
    "prepackage": "node scripts/check-workbench.cjs",
    "package": "vsce package --no-dependencies --out dist/aio-ide.vsix"
  },
  "contributes": {
    "commands": [
      { "command": "aio.openTerminal", "category": "AIO", "title": "选择 AI CLI 并打开终端" },
      { "command": "aio.openOmp", "category": "AIO", "title": "打开 OMP 终端" },
      { "command": "aio.openClaude", "category": "AIO", "title": "打开 Claude Code 终端" },
      { "command": "aio.openCodex", "category": "AIO", "title": "打开 Codex 终端" },
      { "command": "aio.detectClis", "category": "AIO", "title": "检测本机 CLI" },
      { "command": "aio.copyTerminalSelection", "category": "AIO", "title": "复制终端选区", "icon": "$(copy)", "enablement": "aio.activeCliTerminal && terminalTextSelected" },
      { "command": "aio.pasteIntoTerminal", "category": "AIO", "title": "粘贴到终端", "icon": "$(clippy)", "enablement": "aio.activeCliTerminal" },
      { "command": "aio.copyWorkbenchTerminalSelection", "category": "AIO", "title": "复制", "icon": "$(copy)" },
      { "command": "aio.pasteIntoWorkbenchTerminal", "category": "AIO", "title": "粘贴", "icon": "$(clippy)" },
      { "command": "aio.referenceInWorkbench", "category": "AIO", "title": "在 AIO 对话中引用路径", "icon": "$(references)" },
        { "command": "aio.importProjectInWorkbench", "category": "AIO", "title": "在 AIO 中添加项目", "icon": "$(folder-library)" },
        { "command": "aio.openRegisteredProject", "category": "AIO", "title": "打开已登记项目" },
      { "command": "aio.openWorkbench", "category": "AIO", "title": "打开完整工作台" }
    ],
    "menus": {
      "view/title": [
        { "command": "aio.copyTerminalSelection", "when": "view == terminal && aio.activeCliTerminal", "group": "navigation@1" },
        { "command": "aio.pasteIntoTerminal", "when": "view == terminal && aio.activeCliTerminal", "group": "navigation@2" }
      ],
      "webview/context": [
        { "command": "aio.copyWorkbenchTerminalSelection", "when": "webviewId == 'aio.workbench' && webviewSection == 'aioTerminal'", "group": "1_cutcopypaste@1" },
        { "command": "aio.pasteIntoWorkbenchTerminal", "when": "webviewId == 'aio.workbench' && webviewSection == 'aioTerminal'", "group": "1_cutcopypaste@2" }
      ],
      "commandPalette": [
        { "command": "aio.copyTerminalSelection", "when": "aio.activeCliTerminal" },
        { "command": "aio.pasteIntoTerminal", "when": "aio.activeCliTerminal" },
        { "command": "aio.referenceInWorkbench", "when": "false" },
        { "command": "aio.importProjectInWorkbench", "when": "false" },
        { "command": "aio.openRegisteredProject", "when": "false" }
      ],
      "explorer/context": [
        { "command": "aio.referenceInWorkbench", "when": "isWorkspaceTrusted", "group": "navigation@6" },
        { "command": "aio.importProjectInWorkbench", "when": "explorerResourceIsFolder && isWorkspaceTrusted", "group": "navigation@5" },
        { "command": "aio.openTerminal", "when": "explorerResourceIsFolder && isWorkspaceTrusted", "group": "navigation@7" },
        { "command": "aio.openWorkbench", "when": "explorerResourceIsFolder && isWorkspaceTrusted", "group": "navigation@8" }
      ]
    },
    "viewsContainers": {
      "activitybar": [{ "id": "aio", "title": "AIO", "icon": "media/activity.svg" }]
    },
    "views": {
      "aio": [{ "id": "aio.sidebarLaunchers", "name": "编程智能体", "when": "isWorkspaceTrusted" }],
      "explorer": [{ "id": "aio.launchers", "name": "AIO", "when": "isWorkspaceTrusted" }]
    },
    "configuration": {
      "title": "AIO",
      "properties": {
        "aio.ompPath": { "type": "string", "default": "", "scope": "machine", "description": "OMP 可执行文件的绝对路径。留空时自动检测。" },
        "aio.claudePath": { "type": "string", "default": "", "scope": "machine", "description": "Claude Code 可执行文件的绝对路径。留空时自动检测。" },
        "aio.codexPath": { "type": "string", "default": "", "scope": "machine", "description": "Codex 可执行文件的绝对路径。留空时自动检测。" }
      }
    }
  }
}
