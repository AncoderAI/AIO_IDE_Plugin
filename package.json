{
  "name": "aio-ide",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.61",
  "icon": "media/aio.png",
  "publisher": "ancoder",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/AncoderAI/AIO_IDE_Plugin.git" },
  "engines": { "vscode": "^1.97.0" },
  "categories": ["Other"],
  "extensionKind": ["workspace"],
  "main": "./src/extension.js",
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": { "supported": false }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:workbench": "node scripts/build-workbench.cjs",
    "prepackage": "node scripts/check-workbench.cjs",
    "package": "vsce package --no-dependencies --out dist/aio-ide.vsix"
  },
  "contributes": {
    "commands": [
      { "command": "aio.openTerminal", "category": "AIO", "title": "%command.openTerminal%" },
      { "command": "aio.openOmp", "category": "AIO", "title": "%command.openOmp%" },
      { "command": "aio.openClaude", "category": "AIO", "title": "%command.openClaude%" },
      { "command": "aio.openCodex", "category": "AIO", "title": "%command.openCodex%" },
      { "command": "aio.detectClis", "category": "AIO", "title": "%command.detectClis%" },
      { "command": "aio.copyTerminalSelection", "category": "AIO", "title": "%command.copyTerminalSelection%", "icon": "$(copy)", "enablement": "aio.activeCliTerminal && terminalTextSelected" },
      { "command": "aio.pasteIntoTerminal", "category": "AIO", "title": "%command.pasteIntoTerminal%", "icon": "$(clippy)", "enablement": "aio.activeCliTerminal" },
      { "command": "aio.copyWorkbenchTerminalSelection", "category": "AIO", "title": "%command.copy%", "icon": "$(copy)" },
      { "command": "aio.pasteIntoWorkbenchTerminal", "category": "AIO", "title": "%command.paste%", "icon": "$(clippy)" },
      { "command": "aio.referenceInWorkbench", "category": "AIO", "title": "%command.referenceInWorkbench%", "icon": "$(references)" },
        { "command": "aio.importProjectInWorkbench", "category": "AIO", "title": "%command.importProjectInWorkbench%", "icon": "$(folder-library)" },
        { "command": "aio.openRegisteredProject", "category": "AIO", "title": "%command.openRegisteredProject%" },
      { "command": "aio.openWorkbench", "category": "AIO", "title": "%command.openWorkbench%" }
    ],
    "menus": {
      "view/title": [
        { "command": "aio.copyTerminalSelection", "when": "view == terminal && aio.activeCliTerminal", "group": "navigation@1" },
        { "command": "aio.pasteIntoTerminal", "when": "view == terminal && aio.activeCliTerminal", "group": "navigation@2" }
      ],
      "webview/context": [
        { "command": "aio.copyWorkbenchTerminalSelection", "when": "webviewId == 'aio.workbench' && webviewSection == 'aioTerminal'", "group": "1_cutcopypaste@1" },
        { "command": "aio.pasteIntoWorkbenchTerminal", "when": "webviewId == 'aio.workbench' && webviewSection == 'aioTerminal'", "group": "1_cutcopypaste@2" }
      ],
      "commandPalette": [
        { "command": "aio.copyTerminalSelection", "when": "aio.activeCliTerminal" },
        { "command": "aio.pasteIntoTerminal", "when": "aio.activeCliTerminal" },
        { "command": "aio.referenceInWorkbench", "when": "false" },
        { "command": "aio.importProjectInWorkbench", "when": "false" },
        { "command": "aio.openRegisteredProject", "when": "false" }
      ],
      "explorer/context": [
        { "command": "aio.referenceInWorkbench", "when": "isWorkspaceTrusted", "group": "navigation@6" },
        { "command": "aio.importProjectInWorkbench", "when": "explorerResourceIsFolder && isWorkspaceTrusted", "group": "navigation@5" },
        { "command": "aio.openTerminal", "when": "explorerResourceIsFolder && isWorkspaceTrusted", "group": "navigation@7" },
        { "command": "aio.openWorkbench", "when": "explorerResourceIsFolder && isWorkspaceTrusted", "group": "navigation@8" }
      ]
    },
    "viewsContainers": {
      "activitybar": [{ "id": "aio", "title": "AIO", "icon": "media/activity.svg" }]
    },
    "views": {
      "aio": [{ "id": "aio.sidebarLaunchers", "name": "AIO", "when": "isWorkspaceTrusted" }],
      "explorer": [{ "id": "aio.launchers", "name": "AIO", "when": "isWorkspaceTrusted" }]
    },
    "configuration": {
      "title": "AIO",
      "properties": {
        "aio.openWorkbenchOnStartup": { "type": "boolean", "default": true, "scope": "window", "description": "%config.openWorkbenchOnStartup%" },
        "aio.ompPath": { "type": "string", "default": "", "scope": "machine", "description": "%config.ompPath%" },
        "aio.claudePath": { "type": "string", "default": "", "scope": "machine", "description": "%config.claudePath%" },
        "aio.codexPath": { "type": "string", "default": "", "scope": "machine", "description": "%config.codexPath%" }
      }
    }
  }
}
